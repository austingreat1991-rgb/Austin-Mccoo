# GUJIYU AI Video Studio — API Keys
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Anthropic (Claude API — hook and script generation)
ANTHROPIC_API_KEY=

# HeyGen (talking head video generation)
HEYGEN_API_KEY=

# ElevenLabs (voice/TTS generation)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # Aria's voice ID — run: python scripts/elevenlabs_client.py --list-voices

# KREA (cartoon avatar image generation)
KREA_API_KEY=                  # From krea.ai workspace settings

# Airtable (project tracking)
AIRTABLE_API_KEY=              # Personal Access Token (not legacy API key)
AIRTABLE_BASE_ID=              # Found in Airtable URL: airtable.com/<BASE_ID>/...
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_AVATARS_TABLE=AI Avatars
AIRTABLE_ENVIRONMENTS_TABLE=AI Environments
